# ── Supabase (required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret, server only

# ── Public address of this deployment (required: Paystack redirects back here) ─
NEXT_PUBLIC_APP_URL=                  # e.g. https://your-project.vercel.app

# ── AI (required for Spal chat, check-ins, planning drafts) ───────────────────
ANTHROPIC_API_KEY=                    # secret
SPAL_MODEL_MAIN=                      # optional, default claude-sonnet-5-5
SPAL_MODEL_FAST=                      # optional, default claude-haiku-4-5
SPAL_DAILY_TOKEN_BUDGET=              # optional, default 100000 tokens per user per day

# ── Email sign-in codes (required, or nobody can verify their email) ──────────
RESEND_API_KEY=
EMAIL_FROM=                           # optional, default "SPAL <hello@spal.ng>"; the domain must be verified in Resend

# ── Scheduled jobs (required: reminders and push) ─────────────────────────────
CRON_SECRET=                          # any long random string; Vercel sends it to cron routes
NEXT_PUBLIC_VAPID_PUBLIC_KEY=         # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=

# ── Payments (needed for Pro upgrades) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE_MONTHLY=
PAYSTACK_PLAN_CODE_YEARLY=

# ── Voice (optional): speech to text and text to speech still use OpenAI ──────
OPENAI_API_KEY=
