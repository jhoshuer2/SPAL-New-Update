{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/gamification/**",
              "components/navigation/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Tight))/i]",
        "message": "Font not provided by the design system. Available: Inter Tight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|dot|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, color, dot, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:green|orange|blue|purple|gray|red)$/]",
        "message": "<Badge> color must be one of 'green' | 'orange' | 'blue' | 'purple' | 'gray' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|records|insights|profile)$/]",
        "message": "<BottomNav> active must be one of 'home' | 'records' | 'insights' | 'profile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|fullWidth|icon|iconRight|disabled|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, fullWidth, icon, iconRight, disabled, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|padding|elevated|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: accent, padding, elevated, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:green|blue|orange|purple|none)$/]",
        "message": "<Card> accent must be one of 'green' | 'blue' | 'orange' | 'purple' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:sm|md|lg|none)$/]",
        "message": "<Card> padding must be one of 'sm' | 'md' | 'lg' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|prefix|suffix|large|value|placeholder|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, prefix, suffix, large, value, placeholder, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|variant|icon|metric|metricLabel|positive|key|ref|className|style|children)$/]",
        "message": "<InsightCard> doesn't accept that prop. Declared props: title, message, variant, icon, metric, metricLabel, positive."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|celebration|warning|tip)$/]",
        "message": "<InsightCard> variant must be one of 'default' | 'celebration' | 'warning' | 'tip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|color|selected|size|onClick|key|ref|className|style|children)$/]",
        "message": "<PillChip> doesn't accept that prop. Declared props: label, icon, color, selected, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillChip'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:green|blue|orange|purple|gray)$/]",
        "message": "<PillChip> color must be one of 'green' | 'blue' | 'orange' | 'purple' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<PillChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickMenuFab'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSelect|key|ref|className|style|children)$/]",
        "message": "<QuickMenuFab> doesn't accept that prop. Declared props: onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpalSymbol'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|color|size|spin|key|ref|className|style|children)$/]",
        "message": "<SpalSymbol> doesn't accept that prop. Declared props: symbol, color, size, spin."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpalSymbol'] > JSXAttribute[name.name='symbol'] > Literal[value!=/^(?:profit|flow|growth|focus|consistency|momentum|insight|cashflow)$/]",
        "message": "<SpalSymbol> symbol must be one of 'profit' | 'flow' | 'growth' | 'focus' | 'consistency' | 'momentum' | 'insight' | 'cashflow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SparkAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|src|key|ref|className|style|children)$/]",
        "message": "<SparkAvatar> doesn't accept that prop. Declared props: onClick, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavPills'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|key|ref|className|style|children)$/]",
        "message": "<TopNavPills> doesn't accept that prop. Declared props: active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavPills'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|records|insights)$/]",
        "message": "<TopNavPills> active must be one of 'home' | 'records' | 'insights'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UndoToast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|onUndo|onExpire|duration|key|ref|className|style|children)$/]",
        "message": "<UndoToast> doesn't accept that prop. Declared props: message, onUndo, onExpire, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeeklyChallengeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|current|target|completed|key|ref|className|style|children)$/]",
        "message": "<WeeklyChallengeCard> doesn't accept that prop. Declared props: label, current, target, completed."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
